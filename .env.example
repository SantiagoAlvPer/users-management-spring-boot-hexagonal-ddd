# ============================================================
# CONFIGURACION DE ENTORNO: USERS-MANAGEMENT (LOCAL & RENDER)
# ============================================================
# Copia este archivo a .env y llena con tus credenciales reales.
# NUNCA subas .env con credenciales reales a Git.

# --- Servidor ---
PORT=8080

# --- Base de Datos: Supabase (PostgreSQL) ---
# Host de Supabase: aws-0-[region].pooler.supabase.com (pooler) o db.[ref].supabase.co (directo)
DB_HOST=aws-0-us-east-1.pooler.supabase.com
# Puerto: 6543 para pooler con PgBouncer/Supavisor, o 5432 para directo
DB_PORT=6543
# En Supabase la base de datos por defecto siempre es postgres
DB_NAME=postgres
# Usuario: postgres.[ref-de-tu-proyecto] para pooler, o postgres para directo
DB_USERNAME=postgres.tu_ref_proyecto
DB_PASSWORD=tu_password_de_supabase
# Supabase exige SSL obligatorio
DB_SSL_MODE=require
# Opcional: Si prefieres pasar el JDBC URL completo en lugar de las variables anteriores
# DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Cache: Valkey (Aiven / Redis compatible) ---
# CACHE_TYPE: 'none' para desactivar, 'valkey' para activar
CACHE_TYPE=valkey
# Service URI de Aiven Valkey (formato con TLS: rediss://...)
VALKEY_URI=rediss://default:tu_password_valkey@tu-host-valkey.aivencloud.com:puerto
# Tiempo de expiración de la clave user:{id} en segundos (por defecto 300)
CACHE_USER_TTL_SECONDS=300

# --- Seguridad JWT ---
# Secreto en Base64 con al menos 256 bits (32 bytes)
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
JWT_EXPIRATION_SECONDS=900

# --- Mensajería Kafka (Aiven) ---
KAFKA_BOOTSTRAP_SERVERS=tu-host-kafka.aivencloud.com:puerto
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=tu_password_kafka
# Certificado CA de Aiven (contenido completo de ca.pem en una sola línea o saltos)
KAFKA_SSL_CA_PEM=

# --- Notificaciones Email (Brevo SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=tu_usuario_brevo
SMTP_PASSWORD=tu_password_brevo
SMTP_FROM_ADDRESS=tu_correo@ejemplo.com
SMTP_FROM_NAME=Gestion de Usuarios
